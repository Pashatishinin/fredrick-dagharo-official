---
interface Props {
	duration?: number;
	class?: string;
	text?: string; // Можно передать текст пропсом или через слот
}

const { duration = 0.8, class: className, text } = Astro.props;
---

<button class={`decode-button ${className}`} data-duration={duration}>
  <span class="decode-text uppercase">
    {text?.trim()}<slot />
  </span>
</button>

<script>
  import { gsap } from "gsap";

  const symbols = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*?/";

  const setupHoverAnimation = () => {
    const buttons = document.querySelectorAll(".decode-button");

    buttons.forEach((btn) => {
      const textElement = btn.querySelector(".decode-text") as HTMLElement;
      if (!textElement) return;

      const finalWord = textElement.textContent?.trim() || "";

      const duration = parseFloat(btn.getAttribute("data-duration") || "0.8");

      let animation: gsap.core.Tween | null = null;

      btn.addEventListener("mouseenter", () => {
        if (animation) animation.kill();

        let obj = { value: 0 };

        animation = gsap.to(obj, {
          value: finalWord.length,
          duration: duration,
          ease: "none",
          onUpdate: () => {
            // const currentLen = Math.floor(obj.value);
            // const randomPart = Array(finalWord.length - currentLen)
            //   .fill(0)
            //   .map(() => symbols[Math.floor(Math.random() * symbols.length)])
            //   .join("");

            // textElement.textContent =
            //   finalWord.substring(0, currentLen) + randomPart;
            const currentLen = Math.floor(obj.value);

            // Создаем массив из символов финального слова
            const result = finalWord
              .split("")
              .map((char, index) => {
                if (index < currentLen) return char; // Уже "декодированная" часть
                if (char === " ") return " "; // Сохраняем пробелы на своих местах!
                return symbols[Math.floor(Math.random() * symbols.length)];
              })
              .join("");

            textElement.textContent = result;
          },
          onComplete: () => {
            textElement.textContent = finalWord;
          },
        });
      });
    });
  };

  setupHoverAnimation();
  document.addEventListener("astro:page-load", setupHoverAnimation);
</script>

<style>
  .decode-button {
    cursor: pointer;
    background: transparent;
    display: flex;
    align-items: center;
    width: 100%;
    line-height: 1;
    color: #f9f9f9;
    transition: color 0.2s ease;
    text-align: left;
    padding: 0;
    border: none;
  }

  .decode-text {
    display: inline-block;
    font-family: "Space Grotesk", sans-serif;

    font-kerning: none;
    text-rendering: optimizeSpeed;

    font-variant-numeric: tabular-nums;
  }

  .decode-button:hover {
    color: #c0c0c0;
  }
</style>
