---
import { fetchLoaderData } from "../../../entities";

/**
 * Заставка при первом заходе за сессию. Гифка и длительность — из Site
 * Loader в студии. Нет гифки — нет заставки: контент виден сразу.
 */
const { gif, duration } = await fetchLoaderData();

/** Сколько секунд заставка гаснет. */
const FADE = 0.8;

// Первая анимация страницы (например, заголовок About) ждёт, пока
// заставка погаснет; с небольшим запасом.
const heroDelay = duration + FADE + 0.2;
---

{
  gif && (
    <>
      {/*
        Выполняется синхронно, до того как отрисуется контент ниже:
        решает, играть ли заставку, и прячет контент только если играет.
        LOADER_SEEN живёт в window и переживает переходы по сайту —
        заставка не всплывёт снова, даже если она ещё не успела
        записать флаг в sessionStorage.
      */}
      <script is:inline define:vars={{ heroDelay }}>
        const root = document.documentElement;
        let seen = window.LOADER_SEEN === true;
        try {
          seen = seen || sessionStorage.getItem("hasLoaded") === "true";
        } catch {}
        window.LOADER_SEEN = true;

        if (seen) {
          window.HERO_DELAY = 0.2;
        } else {
          root.classList.add("is-loading");
          window.HERO_DELAY = heroDelay;
        }
      </script>

      <div id="loader" class="c-loader" data-duration={duration} data-fade={FADE}>
        <img class="c-loader__media" src={gif} alt="" fetchpriority="high" />
      </div>
    </>
  )
}

<script>
  import { playLoader } from "./loader";

  document.addEventListener("astro:page-load", playLoader);

  // Модуль ждёт загрузки gsap и может выполниться уже ПОСЛЕ того, как
  // ClientRouter разослал astro:page-load — тогда добиваем вызовом
  // напрямую. Повторный запуск защищён флагом внутри playLoader.
  if (document.readyState !== "loading") playLoader();
</script>
