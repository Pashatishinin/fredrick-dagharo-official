---
import { fetchProjectPages } from "../../entities";
import MainLayout from "../../layouts/MainLayout.astro";
import { excerpt } from "../../shared/utils/format";
import ProjectSection from "../../views/project/ProjectSection.astro";

/**
 * Страницы проектов собираются из опубликованных фильмов со слагом.
 * Соседей (предыдущий / следующий) считает fetchProjectPages.
 */
export async function getStaticPaths() {
	const pages = await fetchProjectPages();

	return pages.map((page) => ({
		params: { slug: page.project.slug as string },
		props: { page },
	}));
}

const { page } = Astro.props;
const { project } = page;

// SEO фильма в студии необязательно: пустые поля берём из названия и описания.
const title = project.seo.title || project.title;
const description = project.seo.description || excerpt(project.info) || undefined;
---

<MainLayout title={title} description={description}>
  <ProjectSection page={page} />
</MainLayout>
