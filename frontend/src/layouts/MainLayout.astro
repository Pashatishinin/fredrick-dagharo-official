---
import { ClientRouter } from "astro:transitions";
import DecodeText from "../components/animations/DecodeText.astro";
import CustomCursor from "../components/ui/custom-cursor/CustomCursor.astro";
import Loader from "../components/ui/loader/Loader.astro";
import { fetchSiteSettings } from "../entities";
import { SITE_TITLE } from "../shared/config/titles";
import FooterSection from "../views/footer/FooterSection.astro";
import Header from "../views/header/Header.astro";
import "../shared/styles/main.scss";

interface Props {
	title?: string;
	description?: string;
}

const { title, description } = Astro.props;

// SEO по умолчанию — из Site Settings: его title дописывается к заголовку
// каждой страницы (пусто → заглушка SITE_TITLE), description берётся,
// если у страницы своего нет.
const { seo: siteSeo } = await fetchSiteSettings();
const siteTitle = siteSeo.title || SITE_TITLE;
const pageTitle = title ? `${title} — ${siteTitle}` : siteTitle;
const pageDescription = description || siteSeo.description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {pageDescription && <meta name="description" content={pageDescription} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    {pageDescription && <meta property="og:description" content={pageDescription} />}
    <link rel="icon" href="/favicon.ico" />

    <!-- Видео на сайте живёт на vimeo: заранее открываем соединения,
         чтобы плеер не тратил время на DNS + TLS в момент старта. -->
    <link rel="preconnect" href="https://player.vimeo.com" />
    <link rel="preconnect" href="https://i.vimeocdn.com" />
    <link rel="preconnect" href="https://f.vimeocdn.com" crossorigin />

    <!-- Шрифты подключаем ссылками, а не @import внутри CSS: @import
         выстраивал цепочку — сначала скачать стиль, только потом узнать
         про шрифт, — и задерживал первую отрисовку заголовков. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Averia+Serif+Libre:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap"
    />
    <link rel="stylesheet" href="https://use.typekit.net/bef2bdy.css" />

    <meta name="generator" content={Astro.generator} />

    <script src="../shared/lib/gsap-init.ts"></script>
    <ClientRouter />
    <title>{pageTitle}</title>

    <script is:inline>
      document.addEventListener("astro:before-swap", () => {
        // Сбрасываем прокрутку ДО того, как страницы поменяются местами.
        window.scrollTo(0, 0);
      });

      document.addEventListener("astro:after-swap", () => {
        window.scrollTo({ top: 0, left: 0, behavior: "instant" });
        // При переходе по сайту заставки нет — первая анимация
        // новой страницы стартует почти сразу.
        window.HERO_DELAY = 0.2;
      });
    </script>
  </head>
  <body>
    <Loader />
    <CustomCursor />
    <Header transition:name="hero" transition:persist />

    <main id="main-content">
      <slot />
      <FooterSection />
    </main>

    <button
      id="scroll-top-btn"
      type="button"
      aria-label="Scroll to top"
      transition:persist
      class="c-scroll-top"
    >
      [ <DecodeText as="span">TOP</DecodeText> ]
    </button>
  </body>
</html>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/dist/ScrollTrigger";

  if (typeof window !== "undefined" && history.scrollRestoration) {
    history.scrollRestoration = "manual";
  }

  function setupScrollTopBtn() {
    const btn = document.getElementById("scroll-top-btn");
    if (!btn || btn.dataset.initialized) return;
    btn.dataset.initialized = "true";

    const onScroll = () => btn.classList.toggle("is-visible", window.scrollY > 300);

    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    btn.addEventListener("click", () => {
      gsap.to(window, { scrollTo: 0, duration: 1, ease: "power3.inOut" });
    });
  }

  const onPageLoad = () => {
    requestAnimationFrame(() => window.scrollTo(0, 0));
    setupScrollTopBtn();
    setTimeout(() => ScrollTrigger.refresh(), 650);
  };

  document.addEventListener("astro:page-load", onPageLoad);

  // Модуль ждёт загрузки gsap и может выполниться уже ПОСЛЕ того, как
  // ClientRouter разослал astro:page-load — тогда добиваем напрямую.
  if (document.readyState !== "loading") onPageLoad();

  // Перед уходом со страницы гасим всё, что крутит GSAP: иначе триггеры
  // остаются висеть на уже удалённых узлах.
  document.addEventListener("astro:before-preparation", () => {
    ScrollTrigger.getAll().forEach((t) => t.kill());
    gsap.killTweensOf("*");
  });

  document.addEventListener("astro:after-swap", () => {
    window.scrollTo(0, 0);
  });
</script>
