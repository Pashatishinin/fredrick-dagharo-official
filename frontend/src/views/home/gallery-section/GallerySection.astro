---
import DecodeText from "../../../components/animations/DecodeText.astro";
import Card from "../../../components/common/Card/Card.astro";
import { filmData } from "../../../shared/data/films.data";
import { fetchHomeData } from "../../../shared/fetch";

const bigItems = [6, 11];

const categories = [
	{ url: "/", title: "GRATING" },
	{ url: "/", title: "COMMERCIAL FILMS" },
	{ url: "/", title: "Experimental Films" },
];

const data = filmData;
---

<section class="w-full px-4 py-30">
  <div
    class="w-full grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 py-4 grid-flow-dense"
  >
    {
      data.map((item, index) => {
        return (
          <div class={item.isBig ? "sm:col-span-2 sm:row-span-2" : ""}>
            <a href={`/projects/${item.slug}`}>
              <Card
                number={(index + 1).toString().padStart(2, "0")}
                isBig={item.isBig}
                data={item}
              />
            </a>
          </div>
        );
      })
    }
  </div>
</section>
