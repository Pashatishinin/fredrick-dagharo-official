---
import Header from "../views/header/Header.astro";

import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import CustomCursor from "../components/ui/custom-cursor/CustomCursor.astro";
import Loader from "../components/ui/loader/Loader.astro";
import FooterSection from "../views/footer/FooterSection.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="stylesheet" href="https://use.typekit.net/bef2bdy.css" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>Astro Basics</title>
  </head>
  <body>
    <CustomCursor />
    <Header />
    <slot />
    <FooterSection />
  </body>
</html>

<style>
  html,
  body {
    /* width: 100%; */
    min-height: 100%;
    background-color: #090909;
    color: #f9f9f9;
    max-width: 1920px;
    padding: 0;

    margin: auto;
  }
</style>

<style is:global>
  @import url("https://fonts.googleapis.com/css2?family=Averia+Serif+Libre:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&display=swap");

  body {
    /* font-family: "Space Mono", monospace; */
    font-family: "Space Grotesk", sans-serif;
  }

  h1,
  h5 {
    font-family: "Averia Serif Libre", serif;
    font-weight: 400;
    font-style: normal;
    letter-spacing: -0.1em;
    line-height: 80%;
  }
</style>
