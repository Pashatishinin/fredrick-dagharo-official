---
import { vimeoBackgroundSrc } from "../../../shared/utils/vimeo.utils";

interface Props {
	/** Номер ролика на Vimeo из Site Settings → Footer. */
	vimeoId: string;
}

const { vimeoId } = Astro.props;

const BLOCKS = 500;

const src = vimeoBackgroundSrc(vimeoId);
---

<div>
  <div class="c-footer-video" data-footer-video>
    <!-- src проставляется из data-src, когда футер входит в кадр: фон не
         должен конкурировать за канал с основным видео страницы. -->
    <iframe
      class="c-footer-video__frame"
      data-src={src}
      title=""
      aria-hidden="true"
      tabindex="-1"
      allow="autoplay; fullscreen"></iframe>

    <div class="c-footer-video__overlay"></div>
  </div>

  <div class="c-footer-video__blocks" aria-hidden="true">
    {Array.from({ length: BLOCKS }).map(() => <div class="c-footer-video__block" />)}
  </div>
</div>

<script>
  import { initHoverTrail } from "../../../shared/lib/hover-trail";
  import { mountOnApproach } from "../../../shared/lib/mount-on-approach";

  const init = () => {
    // Футерное видео — декоративный фон, грузим его последним: без запаса
    // по экранам, только когда футер реально появляется.
    mountOnApproach("[data-footer-video]", { screensAhead: 0 });

    // Плитка гаснет под курсором и возвращается — та же механика,
    // что у портрета на About.
    initHoverTrail(
      document.querySelector<HTMLElement>(".c-footer-video__blocks"),
      ".c-footer-video__block",
    );
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>
