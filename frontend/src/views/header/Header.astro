---
import DecodeText from "../../components/animations/DecodeText.astro";
import Clock from "../../components/common/Clock.astro";
import Logo from "../../components/common/Logo.astro";
import { fetchSiteSettings } from "../../entities";
import { NAVIGATION } from "../../shared/config/navigation";

const { logo, logoImage } = await fetchSiteSettings();

const pathname = new URL(Astro.request.url).pathname;
---

<header class="c-header">
  <div class="c-header__inner">
    <div class="c-header__logo">
      <a href="/" id="logo-link" aria-label={logo.join(" ")}>
        <Logo
          lines={logo}
          image={logoImage}
          lineClass="c-header__logo-line"
          imageClass="c-header__logo-image"
        />
      </a>
    </div>

    <ul class="c-header__nav">
      {
        NAVIGATION.map((link) => {
          const isCurrent =
            pathname === link.url || pathname === `${link.url}/`;

          return (
            <li>
              <a
                href={isCurrent ? "javascript:void(0)" : link.url}
                class:list={["c-header__link", { "is-current": isCurrent }]}
              >
                <DecodeText as="span" duration={1}>
                  {link.label}
                </DecodeText>
              </a>
            </li>
          );
        })
      }
    </ul>

    <div class="c-header__clock">
      <Clock />
    </div>
  </div>
</header>

<script>
  import { initLogoScroll } from "../../shared/lib/logo-scroll";

  document.addEventListener("astro:page-load", () =>
    initLogoScroll(document.querySelector<HTMLAnchorElement>("#logo-link")),
  );
</script>
