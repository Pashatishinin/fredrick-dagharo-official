---
import type { Film } from "../../../entities";

/**
 * Карточка фильма: обложка с Vimeo с параллаксом, поверх — гифка,
 * которая проявляется при наведении. Одна на галерею главной и блок
 * «предыдущий / следующий» на странице проекта.
 */
interface Props {
	film: Film;
	/** Порядковый номер в галерее, уже отформатированный: «01». */
	number?: string;
	/** Подпись над названием: «Next Project». */
	subTitle?: string;
	/** Растянуть медиа на всю высоту родителя. */
	fill?: boolean;
	/** Подпись выровнена по правому краю. */
	right?: boolean;
}

const { film, number, subTitle, fill = false, right = false } = Astro.props;
---

<div class:list={["c-card", { "c-card--big": film.isBig, "c-card--fill": fill }]}>
  <div class:list={["c-card__meta", { "is-right": right }]}>
    {number && <p class="c-card__index">[{number}]</p>}

    <div>
      {subTitle && <p class="c-card__subtitle">{subTitle}</p>}
      <p class="c-card__title">{film.title}</p>
    </div>
  </div>

  <div class="c-card__media">
    {
      film.gif && (
        <img class="c-card__gif" src={film.gif} alt="" aria-hidden="true" loading="lazy" />
      )
    }

    <img
      class:list={["c-card__cover", { "has-gif": film.gif }]}
      src={film.cover}
      alt={film.title ?? ""}
      loading="lazy"
    />
  </div>
</div>

<script>
  import { ScrollTrigger } from "gsap/dist/ScrollTrigger";
  import { initParallax } from "../../../shared/animation/parallax";

  /** Насколько обложка ходит внутри рамки, % своей высоты. */
  const PARALLAX_SHIFT = 10;

  // Обложка и гифка до инициализации прозрачны (см. c-card.scss):
  // так не видно рывка, когда GSAP впервые выставляет сдвиг.
  const setupCards = () => {
    const cards = document.querySelectorAll<HTMLElement>(".c-card");
    if (!cards.length) return;

    for (const card of cards) {
      const cover = card.querySelector<HTMLElement>(".c-card__cover");
      if (cover) {
        initParallax(cover, PARALLAX_SHIFT);
        cover.classList.add("initialised");
      }

      card.querySelector(".c-card__gif")?.classList.add("initialised");
    }

    ScrollTrigger.refresh();
  };

  document.addEventListener("astro:page-load", setupCards);
</script>
