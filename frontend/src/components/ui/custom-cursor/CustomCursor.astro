<div id="custom-cursor-outline" class="c-cursor">
  <span class="c-cursor__label js-cursor-play">[ PLAY ]</span>
  <span class="c-cursor__label js-cursor-close">[ CLOSE ]</span>
</div>

<script>
  import { gsap } from "gsap";

  const initCursor = () => {
    const outline = document.getElementById("custom-cursor-outline");
    const playText = document.querySelector(".js-cursor-play") as HTMLElement;
    const closeText = document.querySelector(".js-cursor-close") as HTMLElement;

    if (window.innerWidth < 700 || !outline) return;

    const hideCursor = () => {
      gsap.to(outline, { opacity: 0, duration: 0.2, overwrite: true });
    };

    const resetCursor = () => {
      gsap.to(outline, { opacity: 1, duration: 0.3, overwrite: true });
      if (playText)
        gsap.to(playText, { opacity: 0, duration: 0.3, overwrite: true });
      if (closeText)
        gsap.to(closeText, { opacity: 0, duration: 0.3, overwrite: true });
    };

    const showPlay = () => {
      gsap.to(outline, { opacity: 1, duration: 0.3 });
      if (playText)
        gsap.to(playText, {
          opacity: 1,
          color: "#f9f9f9",
          duration: 0.3,
          overwrite: true,
        });
      if (closeText)
        gsap.to(closeText, { opacity: 0, duration: 0.1, overwrite: true });
    };

    const showClose = () => {
      gsap.to(outline, { opacity: 1, duration: 0.3 });
      if (closeText)
        gsap.to(closeText, {
          opacity: 1,
          color: "#f9f9f9",
          duration: 0.3,
          overwrite: true,
        });
      if (playText)
        gsap.to(playText, { opacity: 0, duration: 0.1, overwrite: true });
    };

    window.addEventListener("mousemove", (e) => {
      const { clientX, clientY } = e;
      const target = e.target as HTMLElement;

      gsap.to(outline, {
        x: clientX,
        y: clientY,
        duration: 0.4,
        ease: "power2.out",
      });

      const modal = document.querySelector(".c-project-modal.is-open");

      if (modal) {
        const isOverVideo = !!target.closest(".c-project-modal__player");
        const isOverCloseBtn = !!target.closest(".c-project-modal__close");
        const isOverHeader =
          !!target.closest("header") || !!target.closest(".header");

        if (isOverCloseBtn || isOverHeader) {
          resetCursor();
        } else if (isOverVideo) {
          hideCursor();
        } else {
          showClose();
        }
      }
    });

    document.addEventListener("mouseover", (e) => {
      const target = e.target as HTMLElement;

      if (target.closest(".c-project-modal__player") && !target.closest(".c-project-modal__close")) {
        hideCursor();
        return;
      }

      if (
        target.closest("a") ||
        target.closest("header") ||
        target.closest(".header")
      ) {
        hideCursor();
        return;
      }

      const isModalOpen = !!document.querySelector(".c-project-modal.is-open");

      if (target.closest(".view") && !isModalOpen) {
        showPlay();
      }
    });

    document.addEventListener("mouseout", (e) => {
      const target = e.target as HTMLElement;
      if (target.closest(".view") || target.closest("a")) {
        resetCursor();
      }
    });

    document.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (
        target.classList.contains("c-project-modal") ||
        target.classList.contains("c-project-modal__close")
      ) {
        resetCursor();
      }
    });
  };

  initCursor();
  document.addEventListener("astro:page-load", initCursor);
</script>
