---
import { Vimeo } from "@astro-community/astro-embed-vimeo";
import MainTitle from "../../../components/ui/titles/main-title/MainTitle.astro";
import { getVimeoThumbnail } from "../../../shared/utils/vimeo.utils";

interface Props {
	data?: {
		title: string;
		isBig: boolean;
		gif?: string;
		slug: string;
		urlVimeo?: string;
	};
}

const { data } = Astro.props;

const cdnLink = await getVimeoThumbnail(data?.urlVimeo, "/image.jpg");
---

<div
  class="video-project-card group relative w-full min-h-screen overflow-hidden"
>
  <div
    class="video-modal fixed inset-0 z-[100] flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300"
  >
    <div class="modal-overlay absolute inset-0 bg-black/90"></div>

    <div
      class="video-container relative z-10 w-[90vw] aspect-video max-w-6xl shadow-2xl"
    >
      <button
        class="close-modal absolute -top-10 right-0 text-[#f9f9f9] text-sm uppercase tracking-widest hover:opacity-60 transition-opacity"
      >
        Close [x]
      </button>

      <div class="cursor-tracker absolute inset-0 z-[50]"></div>

      <!-- <Vimeo
        id=`https://vimeo.com/${data?.urlVimeo}`
        `
        params="controls=1&muted=0&autoplay=0"
      /> -->
      <div class="video-wrapper">
        <iframe
          src={`https://player.vimeo.com/video/${data?.urlVimeo}?controls=1&muted=0&autoplay=0`}
          width="640"
          height="360"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
          data-vimeo-id={data?.urlVimeo}></iframe>
      </div>
    </div>
  </div>
  <div
    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-30 pointer-events-none"
  >
    <MainTitle title={data?.title} />
  </div>

  <img
    src={cdnLink}
    alt="Project Cover"
    class="view parallax-element absolute top-0 left-0 w-full h-full object-cover z-10 cursor-pointer transition-opacity duration-300"
  />
</div>

<style is:global>
  .video-wrapper {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    height: 100%;
    width: auto;
    overflow: hidden;
    z-index: 0;
  }

  .video-wrapper [data-vimeo-embed],
  .video-wrapper lite-vimeo {
    padding-top: 0 !important;
    height: 100% !important;
    width: 100% !important;
    position: absolute !important;
    top: 0;
    left: 0;
  }

  .video-wrapper iframe {
    width: 100% !important;
    height: 100% !important;
    border: none;

    object-fit: cover;
  }

  .video-modal:not(.is-open) iframe {
    pointer-events: none !important;
  }

  .video-container [data-vimeo-embed],
  .video-container lite-vimeo,
  .video-container iframe {
    position: absolute !important;
    top: 0;
    left: 0;
    width: 100% !important;
    height: 100% !important;
    border: none;
  }

  .video-container::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none; /* Это позволит кликать сквозь слой, но поможет браузеру не "терять" мышь */
  }

  /* Состояние когда модалка открыта */
  .video-modal.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .cursor-tracker {
    pointer-events: none; /* Чтобы можно было нажимать на кнопки плеера под ним */
  }

  .view {
    pointer-events: auto !important;
    z-index: 20; /* Поднимем чуть выше оберток */
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/dist/ScrollTrigger";

  import { initParallax } from "../../../shared/animation/parallax";
  import Player from "@vimeo/player";

  gsap.registerPlugin(ScrollTrigger);

  function setupParallax() {
    const elements = document.querySelectorAll(
      ".parallax-element:not(.initialised)",
    );

    elements.forEach((el) => {
      if (el instanceof HTMLElement) {
        initParallax(el, 20);
        el.classList.add("initialised");
      }
    });

    ScrollTrigger.refresh();
  }

  //   function initProjectCard() {
  //     const containers = document.querySelectorAll(".group");

  //     containers.forEach((container) => {
  //       const img = container.querySelector(".view") as HTMLElement;
  //       if (!img) return;

  //       if (!img.classList.contains("initialised")) {
  //         initParallax(img, 20);
  //         img.classList.add("initialised");
  //       }

  //       img.onclick = () => {
  //         img.style.display = "none";

  //         const iframe = container.querySelector("iframe");
  //         if (iframe) {
  //           const player = new Player(iframe);

  //           player.ready().then(() => {
  //             player.play().catch((error) => {
  //               console.error("Видео не смогло запуститься:", error);

  //               player.setMuted(true);
  //               player.play();
  //             });
  //           });
  //         }
  //       };
  //     });
  //   }

  //   initProjectCard();
  //   document.addEventListener("astro:page-load", initProjectCard);

  function initProjectCard() {
    const containers = document.querySelectorAll(".video-project-card");

    containers.forEach((container) => {
      if (container.classList.contains("js-initialized")) return;

      const img = container.querySelector(".view") as HTMLElement;
      const modal = container.querySelector(".video-modal") as HTMLElement;
      const vimeoWrapper = container.querySelector(".video-container"); // Родитель для видео
      const closeBtn = modal.querySelector(".close-modal");

      if (!img || !modal || !vimeoWrapper) return;

      let player: Player | null = null;

      // Функция для получения плеера (создаем один раз при клике)
      const getPlayer = () => {
        if (player) return player;

        // Ищем iframe (он может появиться после рендера lite-vimeo)
        const iframe = vimeoWrapper.querySelector("iframe");
        if (iframe) {
          player = new Player(iframe);
        } else {
          // Если iframe еще нет (lite-vimeo еще не подгрузил его),
          // инициируем через родительский элемент, но это может быть нестабильно.
          // Самый надежный способ - найти lite-vimeo и взять его ID
          const liteVimeo = vimeoWrapper.querySelector("lite-vimeo");
          if (liteVimeo) {
            // @ts-ignore
            const videoId = liteVimeo.getAttribute("videoid") || "392460230";
            player = new Player(liteVimeo as HTMLElement, {
              id: videoId,
              responsive: true,
            });
          }
        }
        return player;
      };

      // Открытие
      img.addEventListener("click", (e) => {
        e.preventDefault();
        modal.classList.add("is-open");
        document.body.style.overflow = "hidden";

        const p = getPlayer();
        if (p) {
          const wrapper = container.querySelector(
            ".video-wrapper",
          ) as HTMLElement;
          if (wrapper) {
            Promise.all([p.getVideoWidth(), p.getVideoHeight()])
              .then(([w, h]) => {
                wrapper.style.aspectRatio = `${w} / ${h}`;
              })
              .catch(() => {});
          }

          p.play().catch(() => {
            p.setMuted(true);
            p.play();
          });
        }
      });

      // Закрытие
      const closeModal = () => {
        modal.classList.remove("is-open");
        document.body.style.overflow = "";
        if (player) player.pause();
      };

      modal.addEventListener("click", (e) => {
        if (
          !(e.target as Element).closest("iframe") &&
          !(e.target as Element).closest(".close-modal")
        ) {
          closeModal();
        }
      });

      // 2. Остановка всплытия (чтобы клики на плеере не закрывали его)
      if (vimeoWrapper) {
        vimeoWrapper.addEventListener("click", (e) => {
          const target = e.target as Element;
          if (target.closest(".video-wrapper") || target.tagName === "IFRAME") {
            e.stopPropagation();
          } else {
            closeModal();
          }
        });
      }

      // 3. Кнопка закрытия
      // if (closeBtn) {
      //   closeBtn.addEventListener("click", (e) => {
      //     console.log("✖️ Клик по кнопке закрытия (крестик)");
      //     e.stopPropagation();
      //     closeModal();
      //   });
      // }

      if (closeBtn) {
        closeBtn.addEventListener("click", (e) => {
          e.stopPropagation(); // Важно, чтобы клик не ушел в контейнер
          closeModal();
        });
      }

      // Параллакс
      if (!img.classList.contains("initialised")) {
        initParallax(img, 20);
        img.classList.add("initialised");
      }

      container.classList.add("js-initialized");
    });
  }

  // Очистка и запуск
  const runInit = () => {
    initProjectCard();
    ScrollTrigger.refresh();
  };

  document.addEventListener("astro:page-load", runInit);
  runInit();

  setupParallax();

  document.addEventListener("astro:page-load", setupParallax);

  window.addEventListener("load", () => ScrollTrigger.refresh());
</script>
