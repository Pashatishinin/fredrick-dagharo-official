<div>
  <div class="absolute inset-0 -z-10 bg-black pointer-events-none">
    <iframe
      src="https://player.vimeo.com/video/1157979063?autoplay=1&muted=1&background=1&loop=1&autopause=0&playsinline=1"
      class="absolute top-1/2 left-1/2 min-w-full min-h-full w-[177.77vh] h-[56.25vw] -translate-x-1/2 -translate-y-1/2"
      frameborder="0"
      allow="autoplay; fullscreen"></iframe>

    <div class="img-overlay"></div>
  </div>

  <div class="absolute inset-0 z-10 text-[#f9f9f9] pointer-events-auto">
    <div class="img-blocks">
      {Array.from({ length: 500 }).map(() => <div class="block" />)}
    </div>
  </div>
</div>

<style>
  .img-overlay {
    position: absolute;
    inset: 0;

    mix-blend-mode: screen;
    background-color: #0f0f0f;
    z-index: 1;
  }

  .img-blocks {
    display: grid;

    grid-template-columns: repeat(auto-fill, minmax(100px, 1fr));
    grid-template-rows: repeat(auto-fill, minmax(100px, 1fr));
    width: 100%;
    height: 100%;
  }

  .block {
    width: 100%;
    height: 100%;
    opacity: 0;
    background-color: #0f0f0f;
    opacity: 1;

    transition: opacity 0.6s ease-out;
  }

  .block.active {
    opacity: 0.5;

    transition: none;
  }
</style>

<script>
  const initBlocks = () => {
    const blocks = document.querySelectorAll(".block");

    blocks.forEach((block) => {
      let timeoutId: ReturnType<typeof setTimeout> | undefined;

      block.addEventListener("mouseenter", () => {
        clearTimeout(timeoutId);
        block.classList.add("active");

        timeoutId = setTimeout(() => {
          block.classList.remove("active");
        }, 400);
      });
    });
  };

  initBlocks();

  document.addEventListener("astro:after-swap", initBlocks);
</script>
