---
interface Props {
	duration?: number;
	class?: string;
	text?: string; // Можно передать текст пропсом или через слот
	/**
	 * Тег обёртки. По умолчанию <button>, но внутри <a> нужно передать "span":
	 * интерактивный элемент внутри интерактивного — невалидная разметка,
	 * ломает клавиатурную навигацию и скринридеры.
	 */
	as?: "button" | "span" | "div";
}

const { duration = 0.8, class: className, text, as: Tag = "button" } = Astro.props;
---

<Tag class:list={["c-decode", className]} data-duration={duration}>
  <span class="c-decode__text">
    {text?.trim()}<slot />
  </span>
</Tag>

<script>
  import { gsap } from "gsap";

  const SYMBOLS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*?/";

  /** Текущая анимация каждого элемента — чтобы новое наведение гасило старую. */
  const running = new WeakMap<HTMLElement, gsap.core.Tween>();

  const decode = (host: HTMLElement) => {
    const textElement = host.querySelector<HTMLElement>(".c-decode__text");
    if (!textElement) return;

    // Исходный текст запоминаем при первом наведении: дальше textContent
    // уже перебирается анимацией, и читать его оттуда нельзя.
    host.dataset.decodeText ??= textElement.textContent?.trim() ?? "";
    const finalWord = host.dataset.decodeText;
    const duration = Number.parseFloat(host.dataset.duration || "0.8");

    running.get(host)?.kill();

    const state = { value: 0 };

    running.set(
      host,
      gsap.to(state, {
        value: finalWord.length,
        duration,
        ease: "none",
        onUpdate: () => {
          const decoded = Math.floor(state.value);

          textElement.textContent = finalWord
            .split("")
            .map((char, index) => {
              if (index < decoded || char === " ") return char;
              return SYMBOLS[Math.floor(Math.random() * SYMBOLS.length)];
            })
            .join("");
        },
        onComplete: () => {
          textElement.textContent = finalWord;
        },
      }),
    );
  };

  // Один слушатель на весь документ вместо обработчика на каждом элементе.
  //  · Модуль выполняется один раз за жизнь вкладки, поэтому переходы через
  //    ClientRouter больше не навешивают дубли — раньше на шапке и кнопке
  //    TOP (они переживают переход) обработчики множились с каждой страницей.
  //  · Элемент ищется в момент наведения, поэтому работает и с разметкой,
  //    которую уже после загрузки перестроил SplitText в TextEffect.
  document.addEventListener("mouseover", (event) => {
    const host = (event.target as Element | null)?.closest<HTMLElement>(".c-decode");
    if (!host) return;

    // mouseover всплывает и с дочерних узлов — запускаем только на входе
    // в элемент снаружи, как это делал mouseenter.
    const from = event.relatedTarget as Node | null;
    if (from && host.contains(from)) return;

    decode(host);
  });
</script>
