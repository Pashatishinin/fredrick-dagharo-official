---
import type { Film } from "../../../entities";

interface Props {
	film: Film;
}

const { film } = Astro.props;
---

<!--
  Номер ролика — в data-film-video, а НЕ в data-vimeo-id: SDK Vimeo при
  загрузке сам превращает в плеер любой элемент с data-vimeo-id.
-->
<section class="c-project-hero" data-project-hero data-film-video={film.urlVimeo}>
  <div class="c-project-hero__title">
    <h1 class="c-project-hero__heading">{film.title}</h1>
  </div>

  <!-- Обложка — кнопка: модалку можно открыть и с клавиатуры -->
  <button type="button" class="c-project-hero__play" aria-label={`Play “${film.title}”`}>
    <img src={film.cover} alt="" class="c-project-hero__cover" />
  </button>

  <!-- inert, пока закрыта: невидимые кнопки не ловят Tab и скринридер -->
  <div class="c-project-modal" role="dialog" aria-modal="true" aria-label={film.title} inert>
    <div class="c-project-modal__overlay"></div>

    <div class="c-project-modal__frame">
      <button type="button" class="c-project-modal__close">Close [x]</button>
      <!-- Плеер вставляет сюда lib/hero.ts при первом нажатии на обложку -->
      <div class="c-project-modal__player"></div>
    </div>
  </div>
</section>
