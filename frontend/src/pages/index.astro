---
import { fetchHomeData } from "../entities";
import MainLayout from "../layouts/MainLayout.astro";
import { PAGE_TITLES } from "../shared/config/titles";
import HomeSection from "../views/home/HomeSection.astro";

const { seo, films } = await fetchHomeData();

if (!films.length) {
	console.warn("[home] В Sanity нет опубликованных фильмов с отметкой Selected Film");
}
---

<MainLayout title={seo.title || PAGE_TITLES.home} description={seo.description || undefined}>
  <HomeSection films={films} />
</MainLayout>
