---
import { fetchPhotographyData } from "../../entities";
import MainLayout from "../../layouts/MainLayout.astro";
import { PAGE_TITLES } from "../../shared/config/titles";
import PhotographySection from "../../views/photography/PhotographySection.astro";

const { seo, photos } = await fetchPhotographyData();

if (!photos.length) {
	console.warn("[photography] В Sanity нет снимков в наборах Photography");
}
---

<MainLayout
  title={seo.title || PAGE_TITLES.photography}
  description={seo.description || undefined}
>
  <PhotographySection photos={photos} />
</MainLayout>
