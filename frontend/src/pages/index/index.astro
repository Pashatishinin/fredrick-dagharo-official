---
import { fetchArchiveData } from "../../entities";
import MainLayout from "../../layouts/MainLayout.astro";
import { PAGE_TITLES } from "../../shared/config/titles";
import ArchiveSection from "../../views/archive/ArchiveSection.astro";

const { seo, films } = await fetchArchiveData();

if (!films.length) {
	console.warn("[archive] В Sanity нет опубликованных фильмов со слагом");
}
---

<MainLayout title={seo.title || PAGE_TITLES.archive} description={seo.description || undefined}>
  <ArchiveSection films={films} />
</MainLayout>
