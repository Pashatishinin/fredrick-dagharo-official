---
import Card from "../../../components/common/Card/Card.astro";

interface Props {
	previous?: any;
	next?: any;
}

const { previous, next } = Astro.props;
---

<section class="flex justify-between items-start py-16 px-4 sm:px-16 gap-8">
  <div class="hidden md:block w-full max-w-100 h-80 overflow-clip">
    <a
      href={`/projects/${previous.slug}`}
      class="group flex flex-col w-full h-full"
    >
      <Card subTitle="Previous Project" data={previous} fill right />
    </a>
  </div>

  <div class="w-full max-w-100 h-80 overflow-clip">
    <a
      href={`/projects/${next.slug}`}
      class="group flex flex-col w-full h-full"
    >
      <Card subTitle="Next Project" data={next} fill />
    </a>
  </div>
</section>
