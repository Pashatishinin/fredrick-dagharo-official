---
import TextEffect from "../../../components/animations/TextEffect.astro";

interface Props {
	data?: {
		title: string;
		isBig: boolean;
		gif?: string;
		slug: string;
		urlVimeo?: string;
		info?: string;
		city?: string;
		year?: string;
	};
}

const { data } = Astro.props;
---

<section
  class="py-16 px-4 sm:px-16 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-16 w-full"
>
  <div class="flex flex-col gap-4 sm:gap-8">
    <p class="text-center sm:text-left text-[12px]">PROJECT NAME</p>
    <p class="text-center sm:text-left uppercase">
      {data?.title}
    </p>
  </div>
  <div
    class="sm:col-span-2 flex flex-col gap-4 sm:gap-8 order-2 sm:order-3 lg:order-2"
  >
    <p class="text-center text-[12px]">MORE INFO</p>
    <TextEffect
      ><p class="uppercase text-center">
        {data?.info}
      </p></TextEffect
    >
  </div>
  <div
    class="sm:col-span-1 flex flex-col gap-4 sm:gap-8 order-3 sm:order-2 lg:order-3"
  >
    <p class="text-center sm:text-right text-[12px]">{data?.year}</p>
    <div>
      <TextEffect
        ><p class="text-center sm:text-right">
          {data?.city}
        </p></TextEffect
      ><TextEffect
        ><p class="text-center sm:text-right">35mm KODAK FILM</p>
      </TextEffect>
    </div>
  </div>
</section>
